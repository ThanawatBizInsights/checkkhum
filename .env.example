# CheckKhum environment variables: PLACEHOLDERS ONLY.
# Copy to .env.local for local development (git ignores it) and put real
# values in your hosting provider's environment settings for production.
# See README.md › "Configuring environment variables" for where to find each value.
#
# Nothing here uses the NEXT_PUBLIC_ prefix except the Turnstile site key,
# so every other value stays on the server and never reaches the browser.

# --- Supabase (enquiry database) ---------------------------------------------
# Required in production together with SUPABASE_SECRET_KEY and ENQUIRY_HASH_SALT;
# if any is missing the forms say online requests are unavailable (nothing is saved).
# Demo mode (both Supabase values empty) only exists under `npm run dev`.
# Project URL: Supabase dashboard > Project Settings > API (or the Connect dialog).
SUPABASE_URL=https://your-project-ref.supabase.co
# Secret key (sb_secret_...): Supabase dashboard > Project Settings > API Keys.
# SERVER ONLY. It bypasses row level security. Never prefix with NEXT_PUBLIC_,
# never commit it, never paste it into client code.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Publishable key (sb_publishable_...): Supabase dashboard > Project Settings > API Keys.
# Used ON THE SERVER by the staff CRM to sign staff in and act as them, so row
# level security applies to every CRM query. It is safe to expose, but this
# project never sends it to the browser.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Random string (32+ characters) used to hash IP addresses and phone numbers
# for rate limiting, so raw values are never stored. Generate with:
#   openssl rand -hex 32
ENQUIRY_HASH_SALT=replace-with-output-of-openssl-rand-hex-32

# --- Cloudflare Turnstile (optional bot check on the forms) ------------------
# Leave both empty to rely on honeypot, timing and rate limits only.
# Cloudflare dashboard > Turnstile > Add widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- LINE Login / LIFF (optional; customers sign in from LINE) ---------------
# Leave both empty to hide LINE Login (email login keeps working).
# LINE Developers Console > your LINE Login channel > LIFF tab > LIFF ID.
# Public by design (the browser needs it to start LIFF). Starts with the channel ID.
NEXT_PUBLIC_LINE_LIFF_ID=
# LINE Developers Console > your LINE Login channel > Basic settings > Channel ID.
# Used on the server to verify LINE ID tokens with LINE. No channel secret is needed.
LINE_LOGIN_CHANNEL_ID=

# Staff accounts are Supabase Auth users with a row in public.staff_users.
# Create the first admin as described in README.md › "Staff CRM".
