# CheckKhum environment variables: PLACEHOLDERS ONLY.
# Copy to .env.local for local development (git ignores it) and put real
# values in your hosting provider's environment settings for production.
# See README.md › "Configuring environment variables" for where to find each value.
#
# Nothing here uses the NEXT_PUBLIC_ prefix except the Turnstile site key,
# so every other value stays on the server and never reaches the browser.

# --- Supabase (enquiry database) ---------------------------------------------
# Leave BOTH empty to run the forms in demo mode (enquiries stay in the browser).
# Project URL: Supabase dashboard > Project Settings > API (or the Connect dialog).
SUPABASE_URL=https://your-project-ref.supabase.co
# Secret key (sb_secret_...): Supabase dashboard > Project Settings > API Keys.
# SERVER ONLY. It bypasses row level security. Never prefix with NEXT_PUBLIC_,
# never commit it, never paste it into client code.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Random string (32+ characters) used to hash IP addresses and phone numbers
# for rate limiting, so raw values are never stored. Generate with:
#   openssl rand -hex 32
ENQUIRY_HASH_SALT=replace-with-output-of-openssl-rand-hex-32

# --- Cloudflare Turnstile (optional bot check on the forms) ------------------
# Leave both empty to rely on honeypot, timing and rate limits only.
# Cloudflare dashboard > Turnstile > Add widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Staff demo login (until staff sign-in moves to Supabase Auth) -----------
# In development, empty values fall back to the demo account in README.md.
# In production, staff login stays disabled unless all three are set.
STAFF_DEMO_EMAIL=
STAFF_DEMO_PASSWORD=
# Generate with: openssl rand -hex 32
STAFF_SESSION_SECRET=
