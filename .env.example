# Staff demo login. The staff area is a demo until a real auth provider is connected.
# In development, these fall back to the defaults documented in README.md.
# In production, staff login stays disabled unless all three are set.
STAFF_DEMO_EMAIL=
STAFF_DEMO_PASSWORD=
# Long random string used to sign the staff session cookie (e.g. `openssl rand -hex 32`).
STAFF_SESSION_SECRET=
